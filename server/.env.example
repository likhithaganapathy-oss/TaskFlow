# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
# For Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/taskflow?retryWrites=true&w=majority
# For Local: mongodb://127.0.0.1:27017/taskflow
MONGODB_URI=<YOUR_MONGODB_CONNECTION_STRING>

# Dedicated Test Database Connection String (Automated tests refuse to run against production/development DB)
# Must contain "test" in the database name to prevent data loss.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017/taskflow_test

# JWT Secret Key — REQUIRED. Generate a strong random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never use a predictable value. Never commit your real secret.
JWT_SECRET=<PASTE_YOUR_GENERATED_SECRET_HERE>

# JWT Expiration (e.g. 7d, 24h)
JWT_EXPIRE=7d

# Frontend origin for CORS (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Administrator credentials — used ONLY by the seed script: npm run seed:admin
# Set a unique strong password. Never leave these as defaults in production.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_STRONG_ADMIN_PASSWORD>
